: url(\"829a71e1-8a0e-4228-9cb1-22a6b5eff9d7\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"2c72bc50-123d-4340-aff3-13561e0af975\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* greek-ext */\n@font-face {\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"ea87c815-eec8-49ac-9437-084a67417617\") format('woff2');\n  unicode-range: U+1F00-1FFF;\n}\n/* greek */\n@font-face {\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"07a390c7-e342-4ee1-8d7b-242833ce1fdb\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"050f6a75-f406-4aa7-91ef-887d0f55e814\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"7ddc5f59-cd62-48d8-8fbf-7eeb24ffd407\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"6ca79ba7-01d8-492c-a002-202479fa0765\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n:root {\n  /* ---- Brand ---------------------------------------------------------- */\n  --primary:          #494fdf;   /* cobalt violet — the only brand stamp   */\n  --primary-bright:   #4f55f1;   /* inline link / accent-photo headers     */\n  --primary-deep:     #3a40c4;   /* pressed/active cobalt                   */\n  --on-primary:       #ffffff;\n\n  /* ---- Canvas / Surface ---------------------------------------------- */\n  --canvas-light:     #ffffff;   /* white catalogue mode                   */\n  --canvas-dark:      #000000;   /* TRUE black storytelling canvas         */\n  --surface-soft:     #f4f4f4;   /* off-white tiles, soft buttons          */\n  --surface-card:     #ffffff;   /* feature cards on light                  */\n  --surface-deep:     #0a0a0a;   /* inset cards inside dark regions         */\n  --surface-elevated: #16181a;   /* plan cards lifted off black            */\n\n  /* ---- Hairlines / Dividers ------------------------------------------ */\n  --hairline-light:   #e2e2e7;\n  --hairline-dark:    rgba(255,255,255,0.12);\n  --hairline-strong:  #191c1f;\n  --divider-soft:     rgba(255,255,255,0.06);\n\n  /* ---- Text ----------------------------------------------------------- */\n  --ink:              #191c1f;   /* primary text on light (warm black)     */\n  --body:             #1f2226;\n  --charcoal:         #3a3d40;\n  --mute:             #505a63;\n  --ash:              #5c5e60;\n  --stone:            #8d969e;\n  --faint:            #c9c9cd;\n  --on-dark:          #ffffff;\n  --on-dark-mute:     rgba(255,255,255,0.72);\n\n  /* ---- Accent palette (ILLUSTRATIONS ONLY — never button surfaces) --- */\n  --accent-teal:        #00a87e;\n  --accent-light-blue:  #007bc2;\n  --accent-blue-link:   #376cd5;\n  --accent-light-green: #428619;\n  --accent-green-text:  #006400;\n  --accent-yellow:      #b09000;\n  --accent-warning:     #ec7e00;\n  --accent-pink:        #e61e49;\n  --accent-danger:      #e23b4a;\n  --accent-deep-red:    #8b0000;\n  --accent-brown:       #936d62;\n  --link:               #376cd5;\n\n  /* ---- Type families -------------------------------------------------- */\n  --font-display: \"General Sans\", \"Aeonik Pro\", \"Inter Display\", \"Inter\", system-ui, sans-serif;\n  --font-body:    \"Inter\", system-ui, -apple-system, sans-serif;\n\n  /* ---- Radii ---------------------------------------------------------- */\n  --r-none: 0px;\n  --r-sm:   8px;\n  --r-md:   12px;\n  --r-lg:   20px;\n  --r-xl:   28px;\n  --r-full: 9999px;\n\n  /* ---- Spacing (base 4) ----------------------------------------------- */\n  --sp-xxs: 4px;\n  --sp-xs:  6px;\n  --sp-sm:  8px;\n  --sp-md:  14px;\n  --sp-lg:  16px;\n  --sp-xl:  24px;\n  --sp-xxl: 32px;\n  --sp-xxxl:48px;\n  --sp-block:   80px;\n  --sp-section: 88px;\n  --sp-band:    120px;\n}\n\n/* ============================================================================\n   TYPOGRAPHY — semantic scale\n   Display = General Sans (Aeonik sub) 500, tight tracking that scales w/ size.\n   Body    = Inter 400, positive tracking on UI labels.\n   ============================================================================ */\n\n/* base reset for specimens */\n.t-display-xxl,.t-display-xl,.t-display-lg,.t-display-md,\n.t-heading-lg,.t-heading-md,.t-heading-sm,\n.t-button-lg { font-family: var(--font-display); font-weight: 500; }\n\n.t-body-lg,.t-body-md,.t-body-md-bold,.t-body-sm,\n.t-button-md,.t-button-sm,.t-caption,.t-link-emph { font-family: var(--font-body); }\n\n.t-display-xxl { font-size: 136px; line-height: 1.0;  letter-spacing: -2.72px; }\n.t-display-xl  { font-size: 80px;  line-height: 1.0;  letter-spacing: -0.8px; }\n.t-display-lg  { font-size: 48px;  line-height: 1.21; letter-spacing: -0.48px; }\n.t-display-md  { font-size: 40px;  line-height: 1.2;  letter-spacing: -0.4px; }\n.t-heading-lg  { font-size: 32px;  line-height: 1.19; letter-spacing: -0.32px; }\n.t-heading-md  { font-size: 24px;  line-height: 1.33; letter-spacing: 0; }\n.t-heading-sm  { font-size: 20px;  line-height: 1.4;  letter-spacing: 0; }\n\n.t-body-lg      { font-size: 18px; font-weight: 400; line-height: 1.56; letter-spacing: -0.09px; }\n.t-body-md      { font-size: 16px; font-weight: 400; line-height: 1.5;  letter-spacing: 0.24px; }\n.t-body-md-bold { font-size: 16px; font-weight: 600; line-height: 1.5;  letter-spacing: 0.16px; }\n.t-body-sm      { font-size: 14px; font-weight: 400; line-height: 1.43; }\n\n.t-button-lg { font-size: 20px; font-weight: 500; line-height: 1.4; }\n.t-button-md { font-size: 16px; font-weight: 600; line-height: 1.5;  letter-spacing: 0.24px; }\n.t-button-sm { font-size: 14px; font-weight: 600; line-height: 1.43; }\n.t-caption   { font-size: 13px; font-weight: 400; line-height: 1.4; }\n.t-link-emph { font-size: 16px; font-weight: 700; line-height: 1.5;  letter-spacing: 0.24px; }\n\n/* ----------------------------------------------------------------------------\n   Semantic element defaults — opt-in by wrapping content in .a4-prose\n   or applying directly. Mirrors the marketing canvas hierarchy.\n   ---------------------------------------------------------------------------- */\n.a4-prose h1 { font-family: var(--font-display); font-weight: 500; font-size: 80px;\n  line-height: 1.0; letter-spacing: -0.8px; color: var(--ink); margin: 0 0 var(--sp-xl); }\n.a4-prose h2 { font-family: var(--font-display); font-weight: 500; font-size: 48px;\n  line-height: 1.21; letter-spacing: -0.48px; color: var(--ink); margin: 0 0 var(--sp-lg); }\n.a4-prose h3 { font-family: var(--font-display); font-weight: 500; font-size: 32px;\n  line-height: 1.19; letter-spacing: -0.32px; color: var(--ink); margin: 0 0 var(--sp-md); }\n.a4-prose h4 { font-family: var(--font-display); font-weight: 500; font-size: 24px;\n  line-height: 1.33; color: var(--ink); margin: 0 0 var(--sp-sm); }\n.a4-prose p  { font-family: var(--font-body); font-weight: 400; font-size: 18px;\n  line-height: 1.56; letter-spacing: -0.09px; color: var(--body); margin: 0 0 var(--sp-lg); }\n.a4-prose a  { color: var(--link); text-decoration: none; }\n.a4-prose a:hover { text-decoration: underline; }\n.a4-prose small { font-family: var(--font-body); font-size: 13px; line-height: 1.4; color: var(--ash); }\n\n/* dark-mode prose */\n.a4-prose--dark h1,.a4-prose--dark h2,.a4-prose--dark h3,.a4-prose--dark h4 { color: var(--on-dark); }\n.a4-prose--dark p { color: var(--on-dark-mute); }\n.a4-prose--dark a { color: var(--primary-bright); font-weight: 700; }\n<\u002Fstyle>\n<style>\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  html, body { margin: 0; background: #000; }\n  body { font-family: var(--font-body); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }\n  ::selection { background: var(--primary); color: #fff; }\n  img { max-width: 100%; }\n\n  @keyframes a4rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }\n  @keyframes a4grow { from { width: 0%; } to { width: 100%; } }\n  @media (max-width: 420px) { .pm-steplabel { display: none; } }\n\n  @media (max-width: 820px) {\n    .lp-grid { grid-template-columns: 1fr !important; }\n  }\n  @media (max-width: 440px) {\n    .lp-tiers { grid-template-columns: 1fr !important; }\n    .a4-navlinks { display: none !important; }\n  }\n  .lucide { display: block; }\n<\u002Fstyle>\n<script src=\"74b42761-8528-4670-a273-c0d52a93b68f\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"37e9934e-d755-4b5a-aa39-ae4dc134edad\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"778efa99-3811-4249-a482-b11862fcede0\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"23e35e93-3179-4c27-8883-492e40dc90ec\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<div id=\"root\"><\u002Fdiv>\n\n\n\n<script type=\"text/babel\" src=\"bc116cec-c2fd-4473-b000-08df8f2558a6\"><\u002Fscript>\n<script type=\"text/babel\" src=\"69693479-8844-4ad1-ba44-dffafac3bc71\"><\u002Fscript>\n<script type=\"text/babel\" src=\"b230d706-34b9-446f-8915-0ee074199a40\"><\u002Fscript>\n<script type=\"text/babel\" src=\"b8bcb218-e6c4-4922-94e9-59a142a6750f\"><\u002Fscript>\n<script type=\"text/babel\" src=\"e42d89f5-ff08-4fec-b71b-0c15bb8acc92\"><\u002Fscript>\n<script type=\"text/babel\" data-presets=\"react\">\n  const mount = () => {\n    if (!window.LandingApp) { setTimeout(mount, 40); return; }\n    ReactDOM.createRoot(document.getElementById(\"root\")).render(<LandingApp />);\n    if (window.lucide) window.lucide.createIcons();\n  };\n  mount();\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"